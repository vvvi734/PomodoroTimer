{
  "name": "pomodoro-timer",
  "version": "1.1.0",
  "description": "Windows 桌面番茄钟（Electron）：深色/亮色双主题、跟随系统、中英双语、长休息、自动隐藏、系统通知与托盘常驻",
  "main": "main.js",
  "author": "pomodoro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "pack": "electron-builder --win portable",
    "pack:dir": "electron-builder --win dir",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.pomodoro",
    "productName": "番茄钟",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "i18n.js",
      "index.html",
      "renderer.js",
      "style.css",
      "assets/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PomodoroTimer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "番茄钟",
      "artifactName": "PomodoroTimer-${version}-${arch}-setup.${ext}"
    }
  }
}
